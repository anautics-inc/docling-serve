# Captify production receiver authentication.
# API-key mode is intentionally not configured and is not a fallback.
DOCLING_SERVE_AUTH_MODE=assertion
DOCLING_SERVE_ASSERTION_ISSUER=captify-pytology
DOCLING_SERVE_ASSERTION_AUDIENCE=docling-service
DOCLING_SERVE_ASSERTION_CLIENT_ID=captify-platform
DOCLING_SERVE_ASSERTION_ALGORITHM=RS256
DOCLING_SERVE_ASSERTION_KMS_KEY_ID=__captify_identity_assertion_kms_key_arn__
DOCLING_SERVE_ASSERTION_KMS_REGION=us-gov-west-1
DOCLING_SERVE_ASSERTION_REDIS_URL=rediss://__shared_redis_endpoint__:6379/0

# Instead of KMS, a receiver may be given only the asymmetric public key:
# DOCLING_SERVE_ASSERTION_KMS_KEY_ID=
# DOCLING_SERVE_ASSERTION_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
