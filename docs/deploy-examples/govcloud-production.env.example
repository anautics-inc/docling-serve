# Store the rendered file as the protected, masked GitLab file variable
# PRODUCTION_ENV. Do not commit real values.

DOCLING_SERVE_DEPLOYMENT_MODE=production
DOCLING_SERVE_AUTH_MODE=assertion
DOCLING_SERVE_ALLOW_DEFAULT_TENANT=false
DOCLING_SERVE_ALLOW_INSECURE_DEVELOPMENT=false
DOCLING_SERVE_CORS_ORIGINS=[]
DOCLING_SERVE_ENABLE_UI=false
DOCLING_SERVE_LOG_FORMAT=json
DOCLING_SERVE_DEBUG_ERROR_DETAILS=false

# One GPU container is deployed by the existing GitLab production job. Keep
# local unless RQ workers are managed by a separate, approved deployment.
DOCLING_SERVE_ENG_KIND=local
UVICORN_WORKERS=1

DOCLING_SERVE_ASSERTION_ISSUER=captify-pytology
DOCLING_SERVE_ASSERTION_AUDIENCE=docling-service
DOCLING_SERVE_ASSERTION_CLIENT_ID=captify-platform
DOCLING_SERVE_ASSERTION_ALGORITHM=RS256
DOCLING_SERVE_ASSERTION_KMS_KEY_ID=__ASSERTION_KMS_KEY_ARN__
DOCLING_SERVE_ASSERTION_KMS_REGION=us-gov-west-1
DOCLING_SERVE_ASSERTION_REDIS_URL=rediss://__ASSERTION_REDIS_ENDPOINT__:6379/0

DOCLING_SERVE_UPLOAD_STAGING_MODE=required
DOCLING_SERVE_UPLOAD_STAGING_BUCKET=__STAGING_BUCKET_NAME__
DOCLING_SERVE_UPLOAD_STAGING_REGION=us-gov-west-1
DOCLING_SERVE_UPLOAD_STAGING_KMS_KEY_ID=__STAGING_KMS_KEY_ARN__
DOCLING_SERVE_UPLOAD_STAGING_VERIFY_SSL=true
DOCLING_SERVE_UPLOAD_STAGING_KEY_PREFIX=docling-staging/v1/
DOCLING_SERVE_UPLOAD_STAGING_RETENTION_DAYS=1
DOCLING_SERVE_UPLOAD_STAGING_CLEANUP_RETENTION_DAYS=7
DOCLING_SERVE_UPLOAD_STAGING_DEAD_LETTER_RETENTION_DAYS=30
DOCLING_SERVE_UPLOAD_STAGING_CLAIM_RETENTION_DAYS=1

DOCLING_SERVE_LEGACY_OFFICE_EXECUTABLE=/usr/bin/soffice
DOCLING_SERVE_SCRATCH_PATH=/mnt/docling/scratch

# Remote model capabilities are disabled unless the private LiteLLM transport,
# secret, approved aliases, budgets, retries, and telemetry are configured.
DOCLING_SERVE_BEDROCK_ENABLED=false
DOCLING_SERVE_FIGURE_HOTSPOT_VISION=false
DOCLING_SERVE_VISION_PARTS=false
DOCLING_SERVE_TECHNICAL_ORDER_DRAWING_TWIN=false
DOCLING_SERVE_GRAPH_EXTRACTION_ENABLED=false
# DOCLING_SERVE_LITELLM_BASE_URL=https://__PRIVATE_LITELLM_ENDPOINT__
# DOCLING_SERVE_LITELLM_API_KEY=__LITELLM_SECRET__

DOCLING_SERVE_OTEL_ENABLE_METRICS=true
DOCLING_SERVE_OTEL_ENABLE_PROMETHEUS=true
DOCLING_SERVE_OTEL_ENABLE_TRACES=false
DOCLING_SERVE_OTEL_SERVICE_NAME=docling-serve
