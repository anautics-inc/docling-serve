{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerPoint Courseware Analysis Summary",
  "type": "object",
  "required": ["artifactKind", "reengineeringCandidateCount"],
  "properties": {
    "artifactKind": { "const": "course_analysis_summary" },
    "moduleCount": { "type": "integer" },
    "slideRecordCount": { "type": "integer" },
    "objectiveCount": { "type": "integer" },
    "assessmentCount": { "type": "integer" },
    "reengineeringCandidateCount": { "type": "integer" }
  }
}
