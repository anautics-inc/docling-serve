# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
#
# Generate reproducible CycloneDX 1.6 dependency SBOMs from the same frozen
# lockfile, base image, and uv release used by the production Containerfile.

ARG BASE_IMAGE=quay.io/sclorg/python-312-c9s:c9s@sha256:012a2fe921fbbf6a297c6ff4827ed73b5dd21e08ccc34e4015586f97b17985fc
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.11.29@sha256:eb2843a1e56fd9e30c7276ce1a52cba86e64c7b385f5e3279a0e08e02dd058fc
ARG CYCLONEDX_BOM_VERSION=7.3.0

FROM ${UV_IMAGE} AS uv-stage

FROM ${BASE_IMAGE} AS build-sbom

ARG CYCLONEDX_BOM_VERSION
ENV UV_PROJECT_ENVIRONMENT=/opt/app-root
WORKDIR /opt/app-root/src
COPY pyproject.toml uv.lock ./
RUN --mount=from=uv-stage,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/opt/app-root/src/.cache/uv,uid=1001 \
    uv sync --frozen --all-extras --no-install-project \
        --no-install-package flash-attn && \
    uv pip install "cyclonedx-bom==${CYCLONEDX_BOM_VERSION}"
RUN mkdir -p /opt/app-root/src/out && \
    /opt/app-root/bin/cyclonedx-py environment /opt/app-root/bin/python \
        --pyproject pyproject.toml \
        --spec-version 1.6 \
        --output-format JSON \
        --output-reproducible \
        --output-file /opt/app-root/src/out/build-sbom.json

FROM ${BASE_IMAGE} AS runtime-sbom

ARG CYCLONEDX_BOM_VERSION
ENV UV_PROJECT_ENVIRONMENT=/opt/app-root
WORKDIR /opt/app-root/src
COPY pyproject.toml uv.lock ./
RUN --mount=from=uv-stage,source=/uv,target=/bin/uv \
    --mount=type=cache,target=/opt/app-root/src/.cache/uv,uid=1001 \
    uv sync --frozen --no-dev --all-extras --no-install-project \
        --no-install-package flash-attn && \
    uv pip install "cyclonedx-bom==${CYCLONEDX_BOM_VERSION}"
RUN mkdir -p /opt/app-root/src/out && \
    /opt/app-root/bin/cyclonedx-py environment /opt/app-root/bin/python \
        --pyproject pyproject.toml \
        --spec-version 1.6 \
        --output-format JSON \
        --output-reproducible \
        --output-file /opt/app-root/src/out/runtime-sbom.json

FROM ${BASE_IMAGE} AS sbom-output

WORKDIR /sbom
COPY --from=build-sbom /opt/app-root/src/out/build-sbom.json ./build-sbom.json
COPY --from=runtime-sbom /opt/app-root/src/out/runtime-sbom.json ./runtime-sbom.json
