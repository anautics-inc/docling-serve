{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PowerPoint Courseware Model",
  "type": "object",
  "required": ["artifactKind", "course", "providerUsage"],
  "properties": {
    "artifactKind": { "const": "course_model" },
    "providerUsage": { "type": "object" },
    "course": {
      "type": "object",
      "required": ["metadata", "modules", "slides", "objectives", "pedagogicalAnalysis", "reengineeringCandidates"],
      "properties": {
        "metadata": { "type": "object", "required": ["courseTitle", "confidence", "provider"] },
        "modules": { "type": "array", "items": { "type": "object", "required": ["id", "title", "slideIds", "confidence", "provider"] } },
        "slides": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["slideId", "role", "primaryRole", "confidence", "provider"],
            "properties": {
              "slideId": { "type": "string" },
              "role": {
                "type": "array",
                "items": {
                  "enum": [
                    "Administrative",
                    "Agenda",
                    "Objective",
                    "Definition",
                    "Explanation",
                    "Concept",
                    "Procedure",
                    "Demonstration",
                    "Guided Practice",
                    "Independent Practice",
                    "Activity",
                    "Assessment",
                    "Feedback",
                    "Recap",
                    "Reference"
                  ]
                }
              },
              "primaryRole": { "type": "string" }
            }
          }
        },
        "objectives": { "type": "array", "items": { "type": "object", "required": ["id", "task", "condition", "standard", "confidence", "provider"] } },
        "assessments": { "type": "array" },
        "pedagogicalAnalysis": { "type": "object" },
        "reengineeringCandidates": { "type": "array" }
      }
    }
  }
}
